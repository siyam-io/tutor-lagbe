{
  "name": "tutor-lagbe",
  "version": "1.0.0",
  "private": true,
  "description": "Tutor Lagbe - Tutor matching platform for Bangladesh",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --names \"frontend,backend\" -c \"blue,green\" \"npm run dev -w @tutor-lagbe/frontend\" \"npm run dev -w @tutor-lagbe/backend\"",
    "dev:frontend": "npm run dev -w @tutor-lagbe/frontend",
    "dev:backend": "npm run dev -w @tutor-lagbe/backend",
    "build": "npm run build -w @tutor-lagbe/frontend && npm run build -w @tutor-lagbe/backend",
    "db:migrate": "npm run db:migrate -w @tutor-lagbe/backend",
    "db:generate": "npm run db:generate -w @tutor-lagbe/backend",
    "db:studio": "npm run db:studio -w @tutor-lagbe/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
